---
import CollectionList from '../../components/CollectionList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatSubtype, getVisibleEntries, sortByRecent, toContentRecord } from '../../utils/content';

const items = sortByRecent(await getVisibleEntries('notes'))
  .map((entry) => toContentRecord('notes', entry));
const types = [...new Set(items.map((item) => formatSubtype(item.type)).filter(Boolean))];
---

<BaseLayout title="笔记" description="技术记录、论文笔记、概念与学习所得。">
  <div class="page-shell">
    <header class="page-header">
      <p class="eyebrow">小块知识</p>
      <h1>笔记</h1>
      <p>记录学习所得、值得保存的命令、调试线索、论文笔记，以及仍在成形的概念。</p>
      {types.length > 0 && <p class="index-facets">类型：{types.join(' · ')}</p>}
    </header>
    <CollectionList items={items} />
  </div>
</BaseLayout>

<style>.index-facets { font-size: .85rem !important; }</style>
