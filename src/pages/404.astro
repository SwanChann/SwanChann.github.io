---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout title="页面未找到" description="无法找到请求的页面。" noindex>
  <div class="page-shell error-page">
    <p class="eyebrow">404</p>
    <h1>页面未找到。</h1>
    <p>页面可能已移动，也可能是链接不完整。</p>
    <nav aria-label="404 页面操作">
      <a href={withBase('/')}>返回首页</a>
      <a href={withBase('/search/')}>搜索网站</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .error-page { min-height: 55vh; display: flex; flex-direction: column; justify-content: center; }
  .error-page p:not(.eyebrow) { color: var(--text-muted); }
  .error-page nav { display: flex; gap: 1.5rem; }
</style>
