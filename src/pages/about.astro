---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';
---

<BaseLayout title="About" description={`About ${siteConfig.name}, current interests, and this personal knowledge space.`}>
  <div class="page-shell narrow-page">
    <header class="page-header">
      <p class="eyebrow">About</p>
      <h1>{siteConfig.name}</h1>
      <p>{siteConfig.introduction}</p>
    </header>

    <section>
      <h2>Current focus</h2>
      <p>This starter is intentionally concise. Replace this paragraph with a verified description of your current work or study direction.</p>
    </section>
    <section>
      <h2>Research interests</h2>
      <p>Embodied intelligence, navigation, AI agents, and research workflows. Edit this list so it represents your actual interests.</p>
    </section>
    <section>
      <h2>Engineering interests</h2>
      <p>Research tooling, maintainable AI workflows, robotics systems, and knowledge infrastructure.</p>
    </section>
    <section>
      <h2>Elsewhere</h2>
      <p>All current and future identity links are maintained on the <a href={withBase('/links/')}>Links page</a>.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .narrow-page { max-width: 48rem; }
  section { margin-top: 3rem; }
  section p { color: var(--text-muted); }
</style>

