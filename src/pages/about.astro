---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';
---

<BaseLayout title="关于" description={`关于 ${siteConfig.name}、当前关注方向与这个个人知识空间。`}>
  <div class="page-shell narrow-page">
    <header class="page-header">
      <p class="eyebrow">关于</p>
      <h1>{siteConfig.name}</h1>
      <p>{siteConfig.introduction}</p>
    </header>

    <section>
      <h2>当前关注</h2>
      <p>我围绕视觉语言模型、机器人导航和科研工作流开展学习与实践。这个网站记录了电网巡检中的 VLM 评测、NoMaD 风格策略在四足机器人上的部署探索，以及 ResearchFlow 的本地科研记录方式。</p>
    </section>
    <section>
      <h2>研究兴趣</h2>
      <p>我关注模型如何利用视觉证据作出判断、机器人上层目标与局部执行能力如何衔接，以及怎样把研究问题变成可复核的实验。已公开的<a href={withBase('/research/')}>研究记录</a>会区分文献结论、个人观察和待验证假设。</p>
    </section>
    <section>
      <h2>工程兴趣</h2>
      <p>科研工具、可维护的 AI 工作流、机器人系统与知识基础设施。</p>
    </section>
    <section>
      <h2>其他平台</h2>
      <p>当前及未来的个人主页入口都维护在<a href={withBase('/links/')}>链接页面</a>。</p>
    </section>
  </div>
</BaseLayout>

<style>
  .narrow-page { max-width: 48rem; }
  section { margin-top: 3rem; }
  section p { color: var(--text-muted); }
</style>
