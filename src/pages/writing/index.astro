---
import CollectionList from '../../components/CollectionList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisibleEntries, sortByRecent, toContentRecord } from '../../utils/content';

const items = sortByRecent(await getVisibleEntries('writing'))
  .map((entry) => toContentRecord('writing', entry));
---

<BaseLayout title="文章" description="关于技术、研究与工作流的长文。">
  <div class="page-shell">
    <header class="page-header">
      <p class="eyebrow">形成中的观点</p>
      <h1>文章</h1>
      <p>在长文中，把笔记、经验与研究逐步发展成完整观点。</p>
    </header>
    <CollectionList items={items} />
  </div>
</BaseLayout>
