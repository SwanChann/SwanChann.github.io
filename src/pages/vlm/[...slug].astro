---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { entrySlug, withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const entries = await getCollection('vlm', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'vlm'> };
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const all = (await getCollection('vlm', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((item) => item.id === entry.id);
const previous = all[index - 1];
const next = all[index + 1];
const related = entry.data.related
  .map((slug) => all.find((item) => entrySlug(item.id) === slug))
  .filter((item): item is CollectionEntry<'vlm'> => Boolean(item));
const href = (item: CollectionEntry<'vlm'>) => withBase(`/vlm/${entrySlug(item.id)}/`);
---

<BaseLayout title={entry.data.title} description={entry.data.description} type="article" modifiedTime={entry.data.updated} noindex={entry.data.draft}>
  <div class="content-page vlm-detail">
    <nav class="vlm-breadcrumb" aria-label="面包屑" data-pagefind-ignore><a href={withBase('/vlm/')}>VLM 知识地图</a><span>/</span><span>{entry.data.area}</span></nav>
    <article class="article" data-pagefind-body data-pagefind-filter="section:VLM">
      <header class="article-header">
        <div class="article-kicker"><span>{entry.data.area}</span><span>{entry.data.level}</span>{entry.data.draft && <span class="draft-label">草稿 · 仅本地可见</span>}</div>
        <h1 data-pagefind-meta="title">{entry.data.title}</h1>
        <p class="article-description">{entry.data.description}</p>
      </header>
      <div class="article-grid">
        <div class="prose"><Content /></div>
        <TableOfContents headings={headings} defaultOpen={false} />
      </div>
      <nav class="article-pagination" aria-label="专题翻页" data-pagefind-ignore>
        <div>{previous && <a href={href(previous)}><span>上一专题</span>{previous.data.title}</a>}</div>
        <div>{next && <a href={href(next)}><span>下一专题</span>{next.data.title}</a>}</div>
      </nav>
    </article>
    {related.length > 0 && <aside class="vlm-related" aria-label="相关专题" data-pagefind-ignore><h2>相关专题</h2><div class="vlm-card-grid">{related.map((item) => <a class="vlm-card" href={href(item)}><span class="vlm-card-meta">{item.data.area} · {item.data.level}</span><strong>{item.data.title}</strong><span>{item.data.description}</span></a>)}</div></aside>}
  </div>
</BaseLayout>
