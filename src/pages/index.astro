---
import CollectionList from '../components/CollectionList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { now } from '../data/now';
import { topics } from '../data/topics';
import { getVisibleEntries, sortByRecent, toContentRecord } from '../utils/content';
import { withBase } from '../utils/paths';

const writing = sortByRecent(await getVisibleEntries('writing'));
const latestWriting = writing.slice(0, 5).map((entry) => toContentRecord('writing', entry));
const latestDaily = sortByRecent(await getVisibleEntries('daily'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3)
  .map((entry) => toContentRecord('daily', entry));
const profiles = siteConfig.socialLinks.filter((link) => !('placeholder' in link && link.placeholder));
---

<BaseLayout>
  <div class="page-shell home-page">
    <section class="home-intro" aria-labelledby="home-title">
      <p class="eyebrow">{siteConfig.tagline}</p>
      <h1 id="home-title">你好，我是 {siteConfig.name}。</h1>
      <p class="home-lede">{siteConfig.introduction}</p>
      <p class="home-description">在这里整理学习笔记、研究问题与工程实践，让零散的探索逐步连成知识。</p>
      <nav class="identity-links" aria-label="了解作者">
        <a href={withBase('/about/')}>关于我</a>
        {profiles.map((link) => <a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}
        <a href={withBase('/rss.xml')}>RSS 订阅</a>
      </nav>
    </section>

    <section class="home-section" aria-labelledby="start-heading">
      <div class="section-heading">
        <h2 id="start-heading">从这里开始</h2>
        <a href={withBase('/start-here/')}>阅读导览 <span aria-hidden="true">→</span></a>
      </div>
      <nav class="topic-guide" aria-label="按主题阅读">
        {topics.map((topic, index) => (
          <a href={withBase('/start-here/') + '#' + topic.id}>
            <span class="topic-number" aria-hidden="true">0{index + 1}</span>
            <span class="topic-copy"><strong>{topic.title}</strong><span>{topic.description}</span></span>
            <span class="topic-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </nav>
    </section>

    <section class="home-section" aria-labelledby="writing-heading">
      <div class="section-heading">
        <h2 id="writing-heading">最近写下的</h2>
        <a href={withBase('/writing/')}>全部文章 <span aria-hidden="true">→</span></a>
      </div>
      <CollectionList items={latestWriting} compact headingLevel={3} />
    </section>

    <section class="home-section" aria-labelledby="daily-heading">
      <div class="section-heading">
        <h2 id="daily-heading">AI 日报</h2>
        <a href={withBase('/daily/')}>按日期阅读 <span aria-hidden="true">→</span></a>
      </div>
      <p>跟踪 AI 论文、模型与工具进展，保留原始来源、研究关联和仍需验证的问题。</p>
      {latestDaily.length > 0 ? <CollectionList items={latestDaily} compact headingLevel={3} />
        : <p class="section-note">栏目已开放，首期日报尚未发布。</p>}
    </section>

    <section class="home-section now-section" aria-labelledby="now-heading">
      <div class="section-heading">
        <h2 id="now-heading">此刻</h2>
        <span class="section-note">记录于 {now.updated}</span>
      </div>
      <div class="now-grid">
        {now.groups.map((group) => (
          <div>
            <h3>{group.label}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <nav class="browse-links" aria-label="更多内容">
      <span>继续探索</span>
      <a href={withBase('/notes/')}>学习笔记</a>
      <a href={withBase('/research/')}>研究记录</a>
      <a href={withBase('/experience/')}>实践经验</a>
      <a href={withBase('/tags/')}>所有标签</a>
    </nav>
  </div>
</BaseLayout>
