---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
};

const props = Astro.props;
const backgroundImage = withBase('/images/star-sea-background.webp');
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111312" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={backgroundImage} as="image" type="image/webp" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} 文章`} href={withBase('/rss.xml')} />
    <SEO {...props} />
    <slot name="head" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('personal-web-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      })();
    </script>
  </head>
  <body style={`--site-background-image: url("${backgroundImage}")`}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
