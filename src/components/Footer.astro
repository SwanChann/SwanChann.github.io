---
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';

const profiles = siteConfig.socialLinks.filter((link) => !('placeholder' in link && link.placeholder));
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="footer-inner">
    <p>© {new Date().getFullYear()} {siteConfig.name}</p>
    <p class="footer-note">{siteConfig.tagline}</p>
    <nav aria-label="页脚导航">
      {profiles.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={withBase('/tags/')}>标签</a>
      <a href={withBase('/rss.xml')}>RSS</a>
    </nav>
  </div>
</footer>
