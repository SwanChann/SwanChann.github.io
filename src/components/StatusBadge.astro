---
type Status = 'seed' | 'growing' | 'mature' | 'evergreen';

type Props = {
  status: Status;
};

const { status } = Astro.props;
const labels: Record<Status, string> = {
  seed: 'Seed',
  growing: 'Growing',
  mature: 'Mature',
  evergreen: 'Evergreen',
};
---

<span class={`status status-${status}`} title={`Digital garden status: ${labels[status]}`}>
  <span aria-hidden="true">●</span> {labels[status]}
</span>

