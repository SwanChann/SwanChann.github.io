---
import type { MarkdownHeading } from 'astro';

type Props = {
  headings: MarkdownHeading[];
  defaultOpen?: boolean;
};

const { headings, defaultOpen = false } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{visibleHeadings.length > 1 && (
  <aside class="toc" aria-label="目录" data-pagefind-ignore>
    <nav class="toc-desktop" aria-label="本页目录">
      <p class="toc-title">本页目录</p>
      <ol>
        {visibleHeadings.map((heading) => (
          <li class={`toc-depth-${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
    <details class="toc-mobile" open={defaultOpen}>
      <summary>本页目录</summary>
      <ol>
        {visibleHeadings.map((heading) => (
          <li class={`toc-depth-${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </details>
  </aside>
)}
