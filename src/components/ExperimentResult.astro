---
type Props = {
  label?: string;
  successRate: number;
  fps: number;
  sample?: boolean;
};

const { label = '实验结果', successRate, fps, sample = true } = Astro.props;
---

<aside class="experiment-result" aria-label={label}>
  <strong>{label}</strong>
  {sample && <span class="sample-mark">示例数据</span>}
  <dl>
    <div><dt>成功率</dt><dd>{(successRate * 100).toFixed(1)}%</dd></div>
    <div><dt>吞吐率</dt><dd>{fps.toFixed(1)} FPS</dd></div>
  </dl>
</aside>
