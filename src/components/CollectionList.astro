---
import type { ContentRecord } from '../utils/content';
import ContentCard from './ContentCard.astro';

type Props = {
  items: ContentRecord[];
  emptyMessage?: string;
};

const { items, emptyMessage = '暂无已发布内容。' } = Astro.props;
---

{items.length > 0 ? (
  <div class="card-list">
    {items.map((item) => <ContentCard item={item} />)}
  </div>
) : (
  <p class="empty-state">{emptyMessage}</p>
)}
